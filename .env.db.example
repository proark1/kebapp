# Wird nur von Compose, Drizzle, Seeds und Integrationstests geladen.
POSTGRES_DB=kebapp
POSTGRES_TEST_DB=kebapp_test
POSTGRES_PORT=5432
POSTGRES_OWNER_USER=kebapp_owner
POSTGRES_OWNER_PASSWORD=change-me-local-owner-password
POSTGRES_APP_USER=kebapp_app
POSTGRES_APP_PASSWORD=change-me-local-app-password

DATABASE_URL=postgresql://kebapp_app:change-me-local-app-password@127.0.0.1:5432/kebapp
DATABASE_OWNER_URL=postgresql://kebapp_owner:change-me-local-owner-password@127.0.0.1:5432/kebapp
TEST_DATABASE_URL=postgresql://kebapp_app:change-me-local-app-password@127.0.0.1:5432/kebapp_test
TEST_DATABASE_OWNER_URL=postgresql://kebapp_owner:change-me-local-owner-password@127.0.0.1:5432/kebapp_test

MAILPIT_SMTP_PORT=1025
MAILPIT_HTTP_PORT=8025

SEED_ADMIN_EMAIL=admin@kebapp.local
SEED_ADMIN_PASSWORD=change-me-local-admin-password
