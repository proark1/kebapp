# Wird von Next.js geladen. Nur Laufzeit-Zugangsdaten eintragen.
DATABASE_URL=postgresql://kebapp_app:change-me-local-app-password@127.0.0.1:5432/kebapp
BETTER_AUTH_SECRET=change-me-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000
DEMO_MODE=false

# Mailpit bleibt lokal und versendet keine echten E-Mails.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM=Kebapp lokal <no-reply@kebapp.local>
