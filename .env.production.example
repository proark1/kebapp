# Wird auf dem Demo-Server als .env.production mit Modus 600 gespeichert.
KEBAPP_HOST=203-0-113-10.sslip.io
COMPOSE_PROJECT_NAME=kebapp-demo

POSTGRES_DB=kebapp
POSTGRES_OWNER_USER=kebapp_owner
POSTGRES_OWNER_PASSWORD=replace-with-random-owner-password
POSTGRES_APP_USER=kebapp_app
POSTGRES_APP_PASSWORD=replace-with-random-runtime-password
DATABASE_OWNER_URL=postgresql://kebapp_owner:replace-with-random-owner-password@postgres:5432/kebapp
DATABASE_URL=postgresql://kebapp_app:replace-with-random-runtime-password@postgres:5432/kebapp

BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=https://203-0-113-10.sslip.io
DEMO_MODE=true

DEMO_ADMIN_EMAIL=admin@demo.kebapp.local
DEMO_ADMIN_PASSWORD=replace-with-random-admin-password
DEMO_SUPPORT_EMAIL=support@demo.kebapp.local
DEMO_SUPPORT_PASSWORD=replace-with-random-support-password
DEMO_OWNER_EMAIL=inhaber@demo.kebapp.local
DEMO_OWNER_PASSWORD=replace-with-random-owner-login-password
DEMO_EMPLOYEE_EMAIL=mitarbeiter@demo.kebapp.local
DEMO_EMPLOYEE_PASSWORD=replace-with-random-employee-password
DEMO_SECOND_OWNER_EMAIL=inhaber-b@demo.kebapp.local
DEMO_SECOND_OWNER_PASSWORD=replace-with-random-second-owner-password
