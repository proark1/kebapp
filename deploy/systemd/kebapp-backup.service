[Unit]
Description=Kebapp PostgreSQL backup
Requires=docker.service
After=docker.service
ConditionPathExists=/opt/kebapp/current/deploy/scripts/backup-postgres.sh

[Service]
Type=oneshot
User=deploy
Group=deploy
WorkingDirectory=/opt/kebapp/current
Environment=KEBAPP_ROOT=/opt/kebapp
Environment=DOCKER_CONFIG=/tmp/docker-config
ExecStart=/opt/kebapp/current/deploy/scripts/backup-postgres.sh
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/backups/kebapp

[Install]
WantedBy=multi-user.target
